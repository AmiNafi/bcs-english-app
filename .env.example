# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables (then redeploy).

# Required. Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Groq model used for AI evaluation (translation + writing).
# Defaults to openai/gpt-oss-120b. Only change this if Groq retires the default —
# check https://console.groq.com/docs/models for current production models.
# GROQ_MODEL=openai/gpt-oss-120b
